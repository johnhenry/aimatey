{
  "name": "@johnhenry/aimatey-cli",
  "version": "0.1.4",
  "description": "CLI tools for Aimatey - proxy server, format converters, Ollama emulation",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "bin": {
    "ai-matey": "./dist/esm/main.js"
  },
  "files": [
    "dist",
    "readme.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@johnhenry/aimatey-types": "^0.5.0",
    "@johnhenry/aimatey-core": "^0.4.0",
    "@johnhenry/aimatey-errors": "^0.2.2",
    "@johnhenry/aimatey-utils": "^0.4.0",
    "@johnhenry/aimatey-backend": "^0.3.1",
    "@johnhenry/aimatey-frontend": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "llm",
    "cli",
    "proxy",
    "ollama",
    "converter",
    "ai-matey"
  ],
  "author": "Aimatey",
  "license": "MIT",
  "homepage": "https://github.com/johnhenry/aimatey#readme",
  "bugs": {
    "url": "https://github.com/johnhenry/aimatey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/aimatey.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
