{
  "name": "@johnhenry/aimatey-frontend",
  "version": "0.2.1",
  "description": "Frontend adapters for Aimatey - Universal AI Adapter System",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/types/adapters/openai.d.ts",
        "default": "./dist/esm/adapters/openai.js"
      },
      "require": {
        "types": "./dist/types/adapters/openai.d.ts",
        "default": "./dist/cjs/adapters/openai.js"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/types/adapters/anthropic.d.ts",
        "default": "./dist/esm/adapters/anthropic.js"
      },
      "require": {
        "types": "./dist/types/adapters/anthropic.d.ts",
        "default": "./dist/cjs/adapters/anthropic.js"
      }
    },
    "./gemini": {
      "import": {
        "types": "./dist/types/adapters/gemini.d.ts",
        "default": "./dist/esm/adapters/gemini.js"
      },
      "require": {
        "types": "./dist/types/adapters/gemini.d.ts",
        "default": "./dist/cjs/adapters/gemini.js"
      }
    },
    "./generic": {
      "import": {
        "types": "./dist/types/adapters/generic.d.ts",
        "default": "./dist/esm/adapters/generic.js"
      },
      "require": {
        "types": "./dist/types/adapters/generic.d.ts",
        "default": "./dist/cjs/adapters/generic.js"
      }
    },
    "./mistral": {
      "import": {
        "types": "./dist/types/adapters/mistral.d.ts",
        "default": "./dist/esm/adapters/mistral.js"
      },
      "require": {
        "types": "./dist/types/adapters/mistral.d.ts",
        "default": "./dist/cjs/adapters/mistral.js"
      }
    },
    "./ollama": {
      "import": {
        "types": "./dist/types/adapters/ollama.d.ts",
        "default": "./dist/esm/adapters/ollama.js"
      },
      "require": {
        "types": "./dist/types/adapters/ollama.d.ts",
        "default": "./dist/cjs/adapters/ollama.js"
      }
    },
    "./chrome-ai": {
      "import": {
        "types": "./dist/types/adapters/chrome-ai.d.ts",
        "default": "./dist/esm/adapters/chrome-ai.js"
      },
      "require": {
        "types": "./dist/types/adapters/chrome-ai.d.ts",
        "default": "./dist/cjs/adapters/chrome-ai.js"
      }
    }
  },
  "files": [
    "dist",
    "readme.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@johnhenry/aimatey-types": "^0.5.0",
    "@johnhenry/aimatey-errors": "^0.2.2",
    "@johnhenry/aimatey-utils": "^0.4.0"
  },
  "devDependencies": {
    "@johnhenry/aimatey-testing": "^0.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "llm",
    "frontend",
    "adapter",
    "openai",
    "anthropic",
    "gemini",
    "ai-matey"
  ],
  "author": "Aimatey",
  "license": "MIT",
  "homepage": "https://github.com/johnhenry/aimatey#readme",
  "bugs": {
    "url": "https://github.com/johnhenry/aimatey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/aimatey.git",
    "directory": "packages/frontend"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
